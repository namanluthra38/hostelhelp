### Get all students
GET http://localhost:4004/students
Authorization: Bearer {{token}}
Accept: application/json

###
POST http://localhost:4004/students/22afce18-8415-41f2-a48a-e819e6111510/assign-hostel
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "hostelId" : "11"
}
###
### Create a new student
POST http://localhost:4004/students
Content-Type: application/json
Accept: application/json

{
  "name": "arpit",
  "email": "arpit@example.com",
  "password": "securePass123",
  "graduationYear": 2027,
  "uid": "23BCS1000113",
  "address": "123 Main St, City",
  "dateOfBirth": "2004-05-15",
  "gender": "Male",
  "phone": "9876543210",
  "roomNumber": 101
}

###

### Update an existing student
PUT http://localhost:4004/students/16f809ea-b801-45d3-af81-b5f5f81b6780
Content-Type: application/json
Accept: application/json

{
  "name": "John Doe Updated twice",
  "email": "john.updated@example.com",
  "password": "newPass456",
  "graduationYear": 2027,
  "uid": "23BCS10001",
  "address": "456 New Address, City",
  "dateOfBirth": "2004-05-15",
  "gender": "Male",
  "phone": "9876543210",
  "hostel": "Hostel B",
  "roomNumber": 202
}
### Get an student
GET http://localhost:4004/students/aea9cdc8-3d7b-4c41-9e43-bbd607c9d764
Content-Type: application/json
Authorization: Bearer {{token}}
Accept: application/json
###

### Get all students
GET http://localhost:4004/students/me
Authorization: Bearer {{token}}
Accept: application/json

### Delete a student
DELETE http://localhost:4004/students/48efc9fc-0d20-4d7c-8d13-7464ccb45ce2
Accept: application/json
Authorization: Bearer {{token}}
###
PUT http://localhost:4004/students/me
